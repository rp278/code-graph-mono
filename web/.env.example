# Base URL of the codegraph-api backend.
# Defaults to http://127.0.0.1:8000 when unset.
VITE_API_URL=http://127.0.0.1:8000

# Bearer token — required only when pointing at a deployment that has
# API_TOKEN set (any codegraph-api reachable from the internet). Leave
# unset for local dev against a local codegraph-api with no API_TOKEN.
VITE_API_TOKEN=
