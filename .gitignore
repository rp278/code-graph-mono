.DS_Store

# Secrets — never commit. Only *.example files are allowed.
.env
.env.*
!.env.example
*.pem
*.key

# codegraph/ and graphify/ are part of this monorepo (tracked).
# The work repos being analysed live in code-repos/ (created by setup.sh) as
# clones or symlinks to their own git repos elsewhere — never track them here.
/code-repos/

# Office/Keynote lock files created while a document is open
~$*
