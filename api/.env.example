# Copy to .env and fill in your values. Never commit .env.
# Neo4j (must match your Neo4j Desktop instance)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-neo4j-password


# Optional overrides
# CODEGRAPH_REPOS=/path/to/repos.json
# GRAPHIFY_DIR=/path/to/graphify

# Cursor models (default "auto" = Cursor picks). Use an id from the SDK model list,
# e.g. claude-sonnet-5-5, claude-opus-5-5, gpt-5.6-sol, composer-2, gemini-3.8-flash.
# ASK_MODEL=auto          # Ask AI (read-only Q&A)
# PIPELINE_MODEL=auto     # Feature Development / Fix Bugs pipelines
