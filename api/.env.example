# Copy to .env and fill in your values. Never commit .env.
# Neo4j (must match your Neo4j Desktop instance)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-neo4j-password

# LLM for chat answers — set one (OpenAI key shown; Anthropic also supported)
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Optional overrides
# CODEGRAPH_REPOS=/path/to/repos.json
# GRAPHIFY_DIR=/path/to/graphify
